# ─────────────────────────────────────────────────────────────────────
# Vite inlines every VITE_-prefixed variable into the PUBLIC JS bundle.
# Anything listed here is readable by anyone who opens the site.
#
# NEVER put an API key or a secret in this file.
#
# VITE_GROQ_API_KEY and the OpenWA credentials (VITE_OPENWA_KEY / _URL /
# _SESSION) used to be here and shipped to every visitor's browser. They have
# been removed from the client. Both keys were public and MUST BE ROTATED —
# removing them from the code does not un-leak the ones already out there.
#
# AI chat and WhatsApp are to be restored via the backend, which keeps its
# keys server-side (backend/Services + Render environment variables).
# ─────────────────────────────────────────────────────────────────────

VITE_API_URL=https://sahtek-tech.onrender.com/api/v1
VITE_USE_MOCK=false
